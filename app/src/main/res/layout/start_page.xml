<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/start_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/menuPageBackgroundColor">

    <ImageView
        android:id="@+id/start_page_UMaineLogo"
        android:layout_width="wrap_content"
        android:layout_height="180dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:contentDescription="@string/UniversityOfMaineLogoImageDescription"
        android:src="@drawable/umaine_logo" />

    <ImageView
        android:id="@+id/start_page_LabLogo"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        android:layout_below="@id/start_page_UMaineLogo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:contentDescription="@string/BiomechanicsLabLogoImageDescription"
        android:src="@drawable/biomechanics_lab_logo" />

    <Button
        android:id="@+id/start_page_ForExperimenters"
        style="?attr/defaultButtonStyle"
        android:layout_width="250dp"
        android:layout_height="100dp"
        android:layout_below="@id/start_page_LabLogo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:text="@string/ForExperimentersButtonText"
        android:textSize="24sp"/>

    <Button
        android:id="@+id/start_page_ForParticipants"
        style="?attr/defaultButtonStyle"
        android:layout_width="250dp"
        android:layout_height="100dp"
        android:layout_below="@id/start_page_ForExperimenters"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:text="@string/ForParticipantsButtonText"
        android:textSize="24sp"/>



</RelativeLayout>