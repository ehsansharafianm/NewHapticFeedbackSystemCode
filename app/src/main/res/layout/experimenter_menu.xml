<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/experimenter_menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/menuPageBackgroundColor">

    <ImageView
        android:id="@+id/experimenter_menu_UMaineLogo"
        android:layout_width="wrap_content"
        android:layout_height="180dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:src="@drawable/umaine_logo"/>

    <View
        android:id="@+id/experimenter_menu_CenterMark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"/>

    <TextView
        android:id="@+id/experimenter_menu_PageTitle"
        style="?attr/colorOnSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/experimenter_menu_UMaineLogo"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:text="Study Selection Menu"
        android:textSize="40sp"/>

    <Button
        android:id="@+id/experimenter_menu_RecordIMUData"
        style="?attr/defaultButtonStyle"
        android:layout_width="180dp"
        android:layout_height="100dp"
        android:layout_below="@id/experimenter_menu_PageTitle"
        android:layout_toStartOf="@id/experimenter_menu_CenterMark"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        android:text="Record\nIMU Data"
        android:textSize="20sp"/>

    <Button
        android:id="@+id/experimenter_menu_TestHapticCells"
        style="?attr/defaultButtonStyle"
        android:layout_width="180dp"
        android:layout_height="100dp"
        android:layout_below="@id/experimenter_menu_PageTitle"
        android:layout_toEndOf="@id/experimenter_menu_CenterMark"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:text="Test\nHaptic Cells"
        android:textSize="20sp"/>

    <Button
        android:id="@+id/experimenter_menu_ThighExtensionStudy"
        style="?attr/defaultButtonStyle"
        android:layout_width="180dp"
        android:layout_height="100dp"
        android:layout_below="@id/experimenter_menu_RecordIMUData"
        android:layout_toStartOf="@id/experimenter_menu_CenterMark"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        android:text="Thigh Extension Study"
        android:textSize="20sp"/>

    <Button
        android:id="@+id/experimenter_menu_WalkingClassificationStudy"
        style="?attr/defaultButtonStyle"
        android:layout_width="180dp"
        android:layout_height="100dp"
        android:layout_below="@id/experimenter_menu_TestHapticCells"
        android:layout_toEndOf="@id/experimenter_menu_CenterMark"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:text="Walking Classification Study"
        android:textSize="20sp"/>

    <Button
        android:id="@+id/experimenter_menu_ArmCuingStudy"
        style="?attr/defaultButtonStyle"
        android:layout_width="180dp"
        android:layout_height="100dp"
        android:layout_below="@id/experimenter_menu_ThighExtensionStudy"
        android:layout_toStartOf="@id/experimenter_menu_CenterMark"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        android:text="Arm Cuing Study"
        android:textSize="20sp"/>

    <Button
        android:id="@+id/experimenter_menu_ArmExtensionStudy"
        style="?attr/defaultButtonStyle"
        android:layout_width="180dp"
        android:layout_height="100dp"
        android:layout_below="@id/experimenter_menu_WalkingClassificationStudy"
        android:layout_toEndOf="@id/experimenter_menu_CenterMark"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:text="Arm Extension Study"
        android:textSize="20sp"/>

    <Button
        android:id="@+id/experimenter_menu_GoBack"
        style="?attr/defaultButtonStyle"
        android:layout_width="180dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="40dp"
        android:text="Go Back"
        android:textSize="20sp"/>

</RelativeLayout>