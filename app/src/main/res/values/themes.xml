<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BiomechanicsLabApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/darkUMaineBlue</item>
        <item name="colorPrimaryVariant">@color/darkUMaineBlueShadow</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/lightUMaineBlue</item>
        <item name="colorSecondaryVariant">@color/lightUMaineBlueShadow</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->

        <!-- Background/Text Colors -->
        <item name="menuPageBackgroundColor"> @color/lightUMaineBlue</item>
        <item name="menuPageTitleTextColor"> @color/black</item>
        <item name="experimentalPageBackgroundColor"> @color/white</item>
        <item name="experimentalPageTitleTextColor"> @color/black</item>
        <item name="experimentalPageHeaderTextColor"> @color/black</item>
        <item name="experimentalPageLabelTextColor"> @color/black</item>
        <item name="experimentalPageNormalTextColor"> @color/black</item>

        <!-- Default Button Styles -->
        <item name="defaultButtonStyle">@style/DarkUMaineBlueButton</item>
        <item name="defaultCircularButtonStyle">@style/DarkUMaineBlueCircularButton</item>

        <!-- Dropdown Spinner Styles -->
        <item name="defaultDropdownSpinner">@style/DarkUMaineBlueDropdownSpinner</item>
        <item name="defaultDropdownSpinnerTextAppearance">@color/white</item>

        <!-- Default Loading Progress Spinner Styles -->
        <item name="loadingProgressSpinnerStyle">@style/DarkLoadingProgressSpinner</item>

        <!-- Default Text Entry Box Styles -->
        <item name="textEntryBoxStyle">@style/DarkUMaineBlueTextEntryBox</item>

        <!-- Default Pop Up Window Styles -->
        <item name="popupWindowStyle">@drawable/light_log_popup_box</item>


    </style>
</resources>